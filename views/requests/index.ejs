<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> - ระบบบริหารฟาร์ม</title>
  <!-- Bootstrap 5 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- ธีมธรรมชาติ (Natural Green Theme) -->
  <link rel="stylesheet" href="/css/theme.css">
  <script>
    (function() {
      const savedTheme = localStorage.getItem('farm-theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-bs-theme', savedTheme);
    })();
  </script>
  <style>
    .status-badge {
      font-size: 0.85rem;
      padding: 0.4em 0.8em;
      border-radius: 20px;
      font-weight: 600;
      display: inline-block;
    }
    .status-pending { background-color: #FEF3D6; color: #925805; border: 1px solid rgba(233, 162, 59, 0.4); }
    .status-approved { background-color: #D8F3DC; color: #1B4332; border: 1px solid rgba(45, 106, 79, 0.3); }
    .status-rejected { background-color: #FDE8E8; color: #C0392B; border: 1px solid rgba(192, 57, 43, 0.3); }
    .status-dispensed { background-color: #E0E7FF; color: #3730A3; border: 1px solid rgba(79, 70, 229, 0.3); }
    .status-completed { background-color: #E2E8F0; color: #475569; border: 1px solid rgba(100, 116, 139, 0.3); }
    .status-cancelled { background-color: #F1F5F9; color: #64748B; border: 1px solid #CBD5E1; }

    /* Dark Mode Overrides for Status Badges */
    [data-bs-theme="dark"] .status-pending { background-color: rgba(233, 162, 59, 0.2); color: #F6C878; border-color: rgba(233, 162, 59, 0.4); }
    [data-bs-theme="dark"] .status-approved { background-color: rgba(45, 106, 79, 0.25); color: #74C69D; border-color: rgba(82, 183, 136, 0.4); }
    [data-bs-theme="dark"] .status-rejected { background-color: rgba(220, 53, 69, 0.2); color: #F87171; border-color: rgba(220, 53, 69, 0.4); }
    [data-bs-theme="dark"] .status-dispensed { background-color: rgba(99, 102, 241, 0.2); color: #A5B4FC; border-color: rgba(99, 102, 241, 0.4); }
    [data-bs-theme="dark"] .status-completed { background-color: rgba(100, 116, 139, 0.2); color: #94A3B8; border-color: rgba(100, 116, 139, 0.4); }
    [data-bs-theme="dark"] .status-cancelled { background-color: rgba(148, 163, 184, 0.15); color: #CBD5E1; border-color: rgba(148, 163, 184, 0.3); }
  </style>
</head>
<body>
  <!-- แถบผู้ดูแลระบบ (หากมีสิทธิ์ Admin) -->
  <% 
    const hasAdminPerm = role === 'admin' || (typeof can === 'function' && (can('acl.manage') || can('user.read') || can('role.read') || can('endpoint.manage') || can('permission.read') || can('log.view')));
  %>
  <% if (hasAdminPerm) { %>
    <div class="admin-mode-bar">
      <span>🛡️ <strong>โหมดผู้ดูแลระบบ (Admin Mode)</strong> - คุณสามารถจัดการคลังและสิทธิ์ได้ทุกฟังก์ชัน</span>
      <a href="/admin/dashboard" class="text-white text-decoration-underline small">ไปยังหน้า Admin Panel &rarr;</a>
    </div>
  <% } %>

  <!-- Topbar สีขาว -->
  <header class="app-topbar sticky-top">
    <div class="container d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/dashboard">
          <span class="fs-4">🌿</span>
          <span class="fw-bold" style="color: var(--green-900); font-size: 1.25rem;">ระบบบริหารฟาร์ม</span>
        </a>
        <div class="vr d-none d-md-block" style="height: 24px;"></div>
        <nav class="d-none d-md-flex align-items-center gap-2">
          <a href="/dashboard" class="text-decoration-none text-muted px-2 py-1">หน้าหลัก</a>
          <a href="/app/inventory" class="text-decoration-none text-muted px-2 py-1">คลังวัสดุและเวชภัณฑ์</a>
          <a href="/app/requests" class="text-decoration-none fw-bold px-2 py-1" style="color: var(--green-700);">
            📋 รายการคำขอเบิก
          </a>
          <% if (hasAdminPerm) { %>
            <a href="/admin/dashboard" class="text-decoration-none text-muted px-2 py-1">Admin Panel</a>
          <% } %>
        </nav>
      </div>

      <div class="d-flex align-items-center gap-3">
        <div class="text-end">
          <span class="fw-semibold text-dark d-none d-sm-inline me-1"><%= fullName %></span>
          <% if (role === 'admin') { %>
            <span class="badge-role badge-role-admin">🛡️ Admin</span>
          <% } else if (role === 'owner') { %>
            <span class="badge-role badge-role-owner">👑 เจ้าของฟาร์ม</span>
          <% } else if (role === 'head') { %>
            <span class="badge-role badge-role-head">👨‍🌾 หัวหน้าโรงเรือน</span>
          <% } else { %>
            <span class="badge-role badge-role-worker">🌱 คนงาน</span>
          <% } %>
        </div>

        <button type="button" class="theme-toggle-btn" onclick="toggleTheme()" title="สลับโหมดมืด/สว่าง">
          🌙
        </button>

        <form method="POST" action="/logout" class="m-0">
          <button type="submit" class="btn btn-secondary btn-sm">🚪 ล็อกเอาท์</button>
        </form>
      </div>
    </div>
  </header>

  <main class="container my-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
      <div>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="/dashboard" class="text-decoration-none">หน้าหลัก</a></li>
            <li class="breadcrumb-item active" aria-current="page">รายการคำขอเบิก</li>
          </ol>
        </nav>
        <h2 class="mb-0 fw-bold text-dark">📋 รายการคำขอเบิกพัสดุและเวชภัณฑ์</h2>
        <p class="text-muted small mb-0 mt-1">
          <%= canApprove ? 'ตรวจสอบและพิจารณาอนุมัติคำขอเบิกของคนงาน พร้อมตัดจ่ายสต็อก' : 'ติดตามสถานะคำขอเบิกของคุณที่ยื่นไปยังหัวหน้า/เจ้าของฟาร์ม' %>
        </p>
      </div>
      <div>
        <a href="/app/inventory" class="btn btn-primary">
          ➕ ไปเลือกของเพื่อยื่นขอเบิก
        </a>
      </div>
    </div>

    <!-- ตารางรายการคำขอเบิก -->
    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">ประวัติและสถานะคำขอเบิก (<%= requests.length %> รายการ)</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th style="min-width: 80px;">รหัสใบเบิก</th>
                <th style="min-width: 140px;">วัน-เวลาที่ยื่น</th>
                <th style="min-width: 130px;">ผู้ขอเบิก</th>
                <th style="min-width: 130px;">โรงเรือน</th>
                <th style="min-width: 180px;">รายการสินค้า</th>
                <th style="min-width: 100px;" class="text-end">จำนวน</th>
                <th style="min-width: 120px;" class="text-center">สถานะ</th>
                <th style="min-width: 160px;">ผู้อนุมัติ/จ่าย</th>
                <th style="min-width: 160px;" class="text-center">การจัดการ</th>
              </tr>
            </thead>
            <tbody>
              <% if (requests.length === 0) { %>
                <tr>
                  <td colspan="9" class="text-center py-5 text-muted">
                    <div class="fs-1 mb-2">📭</div>
                    ยังไม่มีรายการคำขอเบิกในขณะนี้
                  </td>
                </tr>
              <% } %>
              <% requests.forEach(r => { %>
                <tr>
                  <td>
                    <span class="font-monospace fw-bold text-dark">#REQ-<%= r.id %></span>
                  </td>
                  <td>
                    <small class="text-muted">
                      <%= new Date(r.created_at).toLocaleString('th-TH') %>
                    </small>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= r.requester_name %></div>
                    <small class="text-muted">@<%= r.requester_username %></small>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border">
                      🏡 <%= r.house_name %>
                    </span>
                  </td>
                  <td>
                    <a href="/app/inventory/<%= r.item_id %>" class="fw-bold text-decoration-none" style="color: var(--green-900);">
                      <%= r.item_name %>
                    </a>
                    <div class="small text-muted font-monospace"><%= r.item_code %></div>
                    <% if (r.reason) { %>
                      <div class="small text-muted fst-italic mt-1">"<%= r.reason %>"</div>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <span class="fw-bold fs-6 text-dark"><%= parseFloat(r.qty).toLocaleString() %></span>
                    <span class="small text-muted"><%= r.base_unit %></span>
                  </td>
                  <td class="text-center">
                    <% if (r.status === 'pending') { %>
                      <span class="status-badge status-pending">⏳ รออนุมัติ</span>
                    <% } else if (r.status === 'approved') { %>
                      <span class="status-badge status-approved">✓ อนุมัติแล้ว</span>
                    <% } else if (r.status === 'rejected') { %>
                      <span class="status-badge status-rejected">✕ ปฏิเสธ</span>
                    <% } else if (r.status === 'dispensed') { %>
                      <span class="status-badge status-dispensed">📦 จ่ายของแล้ว</span>
                    <% } else if (r.status === 'completed') { %>
                      <span class="status-badge status-completed">🏁 เสร็จสิ้น</span>
                    <% } else { %>
                      <span class="status-badge status-cancelled">🚫 ยกเลิกแล้ว</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (r.approver_name) { %>
                      <div class="small">อนุมัติโดย: <strong><%= r.approver_name %></strong></div>
                    <% } %>
                    <% if (r.dispenser_name) { %>
                      <div class="small text-muted">จ่ายโดย: <%= r.dispenser_name %></div>
                    <% } %>
                    <% if (r.approve_note) { %>
                      <div class="small text-danger mt-1">หมายเหตุ: <%= r.approve_note %></div>
                    <% } %>
                    <% if (!r.approver_name && !r.dispenser_name) { %>
                      <span class="text-muted small">-</span>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <div class="d-flex justify-content-center gap-1">
                      <!-- ปุ่มสำหรับผู้อนุมัติ (owner, head, admin) เมื่อสถานะ pending -->
                      <% if (canApprove && r.status === 'pending') { %>
                        <% if (role === 'admin' || (typeof can === 'function' && can('request.approve'))) { %>
                          <button class="btn btn-success btn-sm px-2" onclick="approveReq(<%= r.id %>)" title="อนุมัติคำขอเบิก">
                            ✓ อนุมัติ
                          </button>
                        <% } %>
                        <% if (role === 'admin' || (typeof can === 'function' && can('request.reject'))) { %>
                          <button class="btn btn-outline-danger btn-sm px-2" onclick="rejectReq(<%= r.id %>)" title="ปฏิเสธคำขอเบิก">
                            ✕ ปฏิเสธ
                          </button>
                        <% } %>
                      <% } %>

                      <!-- ปุ่มสำหรับจ่ายของ (เมื่อ approved แล้ว) -->
                      <% if (canApprove && r.status === 'approved') { %>
                        <% if (role === 'admin' || (typeof can === 'function' && can('request.dispense'))) { %>
                          <button class="btn btn-primary btn-sm px-2" onclick="dispenseReq(<%= r.id %>)" title="ตัดสต็อกจ่ายของ">
                            📦 จ่ายของ
                          </button>
                        <% } %>
                      <% } %>

                      <!-- ปุ่มสำหรับคนงานยกเลิกคำขอตัวเอง (เมื่อยัง pending) -->
                      <% if (r.requester_id === userId && r.status === 'pending') { %>
                        <button class="btn btn-outline-secondary btn-sm px-2" onclick="cancelReq(<%= r.id %>)" title="ยกเลิกคำขอ">
                          ยกเลิก
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/farm-modal.js"></script>
  <script>
    async function approveReq(id) {
      const confirmed = await farmConfirm({
        title: 'ยืนยันการอนุมัติและตัดจ่ายสต็อก',
        message: `คุณต้องการอนุมัติคำขอเบิก #${id} ใช่หรือไม่?\n(ระบบจะทำการตัดยอดสต็อกตามหลัก FEFO/FIFO ทันที)`,
        type: 'success',
        icon: '✅',
        confirmText: 'อนุมัติและตัดสต็อก'
      });
      if (!confirmed) return;

      try {
        const res = await fetch(`/app/requests/${id}/approve`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });
        const json = await res.json();
        if (res.ok) {
          await farmAlert(json.message, 'สำเร็จ', 'success');
          window.location.reload();
        } else {
          farmAlert(json.error || 'อนุมัติไม่สำเร็จ', 'ข้อผิดพลาด', 'danger');
        }
      } catch (e) {
        farmAlert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์', 'ข้อผิดพลาด', 'danger');
      }
    }

    async function rejectReq(id) {
      const reason = prompt('กรุณาระบุเหตุผลในการปฏิเสธคำขอเบิกนี้:');
      if (reason === null) return;
      if (!reason.trim()) {
        alert('จำเป็นต้องระบุเหตุผลในการปฏิเสธ');
        return;
      }

      try {
        const res = await fetch(`/app/requests/${id}/reject`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ note: reason })
        });
        const json = await res.json();
        if (res.ok) {
          await farmAlert(json.message, 'สำเร็จ', 'success');
          window.location.reload();
        } else {
          farmAlert(json.error || 'ปฏิเสธไม่สำเร็จ', 'ข้อผิดพลาด', 'danger');
        }
      } catch (e) {
        farmAlert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์', 'ข้อผิดพลาด', 'danger');
      }
    }

    async function dispenseReq(id) {
      const confirmed = await farmConfirm({
        title: 'ยืนยันการจ่ายของออกจากคลัง',
        message: `ระบบจะทำการตัดสต็อกจริงตามหลัก FEFO/FIFO ให้โดยอัตโนมัติ ยืนยันการตัดจ่ายหรือไม่?`,
        type: 'warning',
        icon: '📦',
        confirmText: 'ตัดจ่ายของทันที'
      });
      if (!confirmed) return;

      try {
        const res = await fetch(`/app/requests/${id}/dispense`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });
        const json = await res.json();
        if (res.ok) {
          await farmAlert(json.message, 'สำเร็จ', 'success');
          window.location.reload();
        } else {
          farmAlert(json.error || 'จ่ายของไม่สำเร็จ', 'ข้อผิดพลาด', 'danger');
        }
      } catch (e) {
        farmAlert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์', 'ข้อผิดพลาด', 'danger');
      }
    }

    async function cancelReq(id) {
      const confirmed = await farmConfirm({
        title: 'ยืนยันการยกเลิกคำขอเบิก',
        message: 'คุณต้องการยกเลิกคำขอเบิกนี้ใช่หรือไม่?',
        type: 'danger',
        icon: '🗑️',
        confirmText: 'ยกเลิกคำขอ'
      });
      if (!confirmed) return;

      try {
        const res = await fetch(`/app/requests/${id}/cancel`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const json = await res.json();
        if (res.ok) {
          await farmAlert(json.message, 'สำเร็จ', 'success');
          window.location.reload();
        } else {
          farmAlert(json.error || 'ยกเลิกไม่สำเร็จ', 'ข้อผิดพลาด', 'danger');
        }
      } catch (e) {
        farmAlert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์', 'ข้อผิดพลาด', 'danger');
      }
    }
  </script>
  <script src="/js/theme-toggle.js"></script>
</body>
</html>
