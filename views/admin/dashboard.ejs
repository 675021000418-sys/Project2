<%- include('layout', {
  pageTitle: 'Dashboard',
  fullName: fullName,
  role: role,
  activeMenu: 'dashboard',
  body: `
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="mb-1">📊 Admin Dashboard</h2>
        <p class="text-muted mb-0">ระบบบริหารฟาร์มและโรงเรือน (Farm Management System)</p>
      </div>
      <div>
        <span class="badge bg-primary px-3 py-2 fs-6">สถานะ: ผู้ดูแลระบบ</span>
      </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card stat-card bg-primary text-white h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <p class="card-text text-white-50 mb-1">ผู้ใช้ทั้งหมด</p>
                <h3 class="card-title mb-0" id="stat-users">-</h3>
              </div>
              <div class="stat-icon">👥</div>
            </div>
          </div>
          <div class="card-footer bg-transparent border-0 pt-0">
            <a href="/admin/users" class="text-white text-decoration-none small">ดูรายการผู้ใช้ &rarr;</a>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card stat-card bg-success text-white h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <p class="card-text text-white-50 mb-1">บทบาท (Roles)</p>
                <h3 class="card-title mb-0" id="stat-roles">-</h3>
              </div>
              <div class="stat-icon">🔖</div>
            </div>
          </div>
          <div class="card-footer bg-transparent border-0 pt-0">
            <a href="/admin/roles" class="text-white text-decoration-none small">ดูรายการ Roles &rarr;</a>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card stat-card bg-warning text-dark h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <p class="card-text text-muted mb-1">สิทธิ์ (Permissions)</p>
                <h3 class="card-title mb-0" id="stat-permissions">-</h3>
              </div>
              <div class="stat-icon">🔑</div>
            </div>
          </div>
          <div class="card-footer bg-transparent border-0 pt-0">
            <a href="/admin/permissions" class="text-dark text-decoration-none small">ดูรายการ Permissions &rarr;</a>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card stat-card bg-info text-white h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <p class="card-text text-white-50 mb-1">คำขอเบิกรอดำเนินการ</p>
                <h3 class="card-title mb-0" id="stat-pending">-</h3>
              </div>
              <div class="stat-icon">📋</div>
            </div>
          </div>
          <div class="card-footer bg-transparent border-0 pt-0">
            <span class="text-white small">รอการอนุมัติ</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Actions and Recent Logs -->
    <div class="row g-4">
      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-header bg-white">
            <h5 class="mb-0">⚡ เมนูด่วน (Quick Actions)</h5>
          </div>
          <div class="card-body d-flex flex-column gap-2">
            <a href="/admin/users" class="btn btn-quick-action text-start"><span>👥</span> <span>จัดการผู้ใช้ในระบบ</span></a>
            <a href="/admin/roles" class="btn btn-quick-action text-start"><span>🔖</span> <span>จัดการ Roles</span></a>
            <a href="/admin/permissions" class="btn btn-quick-action text-start"><span>🔑</span> <span>จัดการ Permissions</span></a>
            <a href="/admin/acl" class="btn btn-quick-action text-start"><span>🔐</span> <span>กำหนด ACL Matrix</span></a>
            <a href="/admin/endpoints" class="btn btn-quick-action text-start"><span>🔗</span> <span>ผูก Endpoint Permissions</span></a>
            <a href="/admin/logs" class="btn btn-quick-action text-start"><span>📋</span> <span>ดู Audit Logs</span></a>
          </div>
        </div>
      </div>
      <div class="col-md-8">
        <div class="card shadow-sm h-100">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">📋 กิจกรรมล่าสุด (Audit Logs)</h5>
            <a href="/admin/logs" class="btn btn-sm btn-outline-secondary">ดูทั้งหมด</a>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover table-striped mb-0" id="recent-logs-table">
                <thead class="table-light">
                  <tr>
                    <th>เวลา</th>
                    <th>ผู้ใช้</th>
                    <th>เหตุการณ์</th>
                    <th>ผลลัพธ์</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td colspan="4" class="text-center text-muted py-3">กำลังโหลดข้อมูล...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  `,
  scripts: `
    <script>
      async function loadDashboard() {
        try {
          const statsRes = await fetch('/api/admin/stats');
          if (statsRes.ok) {
            const data = await statsRes.json();
            document.getElementById('stat-users').textContent = data.users || 0;
            document.getElementById('stat-roles').textContent = data.roles || 0;
            document.getElementById('stat-permissions').textContent = data.permissions || 0;
            document.getElementById('stat-pending').textContent = data.pendingRequests || 0;
          }

          const logsRes = await fetch('/api/admin/logs?limit=5');
          if (logsRes.ok) {
            const logs = await logsRes.json();
            const tbody = document.querySelector('#recent-logs-table tbody');
            if (!logs || logs.length === 0) {
              tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">ยังไม่มีบันทึกกิจกรรม</td></tr>';
            } else {
              tbody.innerHTML = logs.map(l => {
                const color = l.result === 'success' ? 'success' : (l.result === 'fail' ? 'danger' : 'warning');
                const time = new Date(l.created_at).toLocaleTimeString('th-TH');
                const user = l.username || l.username_attempted || '-';
                return '<tr>' +
                  '<td>' + time + '</td>' +
                  '<td>' + user + '</td>' +
                  '<td>' + l.event_type + '</td>' +
                  '<td><span class="badge bg-' + color + '">' + l.result + '</span></td>' +
                '</tr>';
              }).join('');
            }
          }
        } catch (err) {
          console.error('Error loading dashboard:', err);
        }
      }
      loadDashboard();
    </script>
  `
}) %>
