# การตั้งค่าเซิร์ฟเวอร์
PORT=3000
NODE_ENV=development

# การตั้งค่าฐานข้อมูล PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farm_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# การตั้งค่า Session
SESSION_SECRET=your_random_secret_key_here_change_this_in_production
SESSION_COOKIE_SECURE=false  # true สำหรับ production (HTTPS)

# การตั้งค่าอัปโหลดไฟล์
MAX_FILE_SIZE=2097152  # 2MB เป็น bytes
UPLOAD_DIR=./uploads
